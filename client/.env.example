# Backend REST API URL
# In local development: /api (proxied by Vite)
# In production (e.g. Render): https://your-backend-service.onrender.com/api
VITE_API_URL=/api

# WebSocket Server URL
# In local development: http://localhost:5000
# In production (e.g. Render): https://your-backend-service.onrender.com
VITE_SOCKET_URL=http://localhost:5000
