# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local MongoDB: mongodb://127.0.0.1:27017/realtime_analytics
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/realtime_analytics
MONGO_URI=mongodb://127.0.0.1:27017/realtime_analytics

# JWT Secret Key
JWT_SECRET=super_secret_jwt_key_realtime_analytics_2026_secure!

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Telemetry Generator Interval (in milliseconds)
TELEMETRY_INTERVAL_MS=3000
